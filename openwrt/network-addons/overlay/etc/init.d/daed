#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1
start_service() {
    mkdir -p /etc/daed-kdae
    chmod 700 /etc/daed-kdae
    procd_open_instance
    procd_set_param command /bin/sh -c 'n=0; while ! ip -4 route show default | grep -q .; do n=$((n+1)); [ "$n" -ge 150 ] && break; sleep 1; done; exec /usr/bin/daed run -c /etc/daed-kdae -l 0.0.0.0:2023'
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param limits nofile="1048576 1048576"
    procd_close_instance
}
