#!/bin/sh
# A short process freeze produces one consistent local state archive, including
# SQLite WAL files. The EXIT trap resumes every app even if tar fails.
set -eu
root=${1:?root view}; output=${2:?settings archive}; exclude=${3:?software list}
shift 3
pids=
resume() {
    for pid in $pids; do kill -CONT "$pid" 2>/dev/null || :; done
}
trap resume EXIT
trap 'exit 1' HUP INT TERM
for name in daed owjdxb ownbsvman NodeBabyLinkService owjdgjman; do
    for pid in $(pidof "$name" 2>/dev/null || :); do
        case "$pid" in *[!0-9]*|'') exit 1;; esac
        # Remember the PID before STOP so an interruption cannot leave it frozen.
        pids="$pids $pid"
        kill -STOP "$pid" 2>/dev/null || :
    done
done
tar -C "$root" -X "$exclude" -cf "$output" "$@"
