#!/bin/sh
stop() { /usr/local/owjdxb/stop.sh >/tmp/owjdxb-stop.log 2>&1; exit 0; }
trap stop TERM INT
n=0
while [ "$n" -lt 150 ]; do
    [ -c /dev/net/tun ] && ip -4 route show default | grep -q . && break
    n=$((n+1)); sleep 1
done
/usr/local/owjdxb/start.sh >/tmp/owjdxb-start.log 2>&1
while sleep 15; do
    pidof owjdxb >/dev/null || /usr/local/owjdxb/start.sh >>/tmp/owjdxb-start.log 2>&1
done
