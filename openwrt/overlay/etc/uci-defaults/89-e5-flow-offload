#!/bin/sh
# Software flow offloading on first boot.
#
# The stock firewall defaults leave `flow_offloading` unset, so a fresh install
# routes every packet through the CPU: measured throughput lands at about an
# eighth of what the modem can carry.  Turning it on moves established flows to
# the kernel's flow table and gets the expected rate back.
#
# Hardware offloading (`flow_offloading_hw`) stays off on purpose:
#  * it pushes flows into the SIPAs, bypassing the CPU, so anything that needs to
#    see the packets -- the fixed-TTL option and daed's eBPF data plane -- stops
#    working;
#  * software offloading already reaches the link rate here, so the extra
#    hardware step buys nothing.
#
# The TTL feature (when enabled) also drops `flow_offloading` on purpose and
# records the previous value in /etc/mu300/; this script only seeds the initial
# default and never overrides a choice made later in LuCI.
#
# r20261112

[ -f /etc/config/firewall ] || exit 0

# Keep it idempotent: only seed when the option is absent, and only force the
# hardware switch off when it was explicitly turned on.
uci -q get firewall.@defaults[0].flow_offloading >/dev/null 2>&1 \
	|| uci set firewall.@defaults[0].flow_offloading='1'

if [ "$(uci -q get firewall.@defaults[0].flow_offloading_hw)" = "1" ]; then
	uci set firewall.@defaults[0].flow_offloading_hw='0'
fi

uci commit firewall

# fw4 picks the new value up on the next reload; do it now so the first boot is
# already fast instead of waiting for the next WAN event.
/etc/init.d/firewall reload >/dev/null 2>&1

exit 0
