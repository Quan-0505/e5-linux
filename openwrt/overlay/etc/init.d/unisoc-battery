#!/bin/sh /etc/rc.common
START=86
STOP=08
USE_PROCD=1

start_service() {
    [ -s /etc/e5/device-profile ] || return 0
    procd_open_instance
    procd_set_param command /usr/bin/ucode /usr/libexec/unisoc-battery/watch.uc
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
