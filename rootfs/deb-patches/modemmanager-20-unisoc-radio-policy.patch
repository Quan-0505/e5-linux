 static void
+init_radio_policy_ready (MMBaseModem *self, GAsyncResult *res, GTask *task)
+{
+    GError *error = NULL;
+    mm_base_modem_at_sequence_finish (self, res, NULL, &error);
+    if (error) {
+        init_power_failed (self, task, error);
+        return;
+    }
+    g_task_return_pointer (task, g_task_get_task_data (task), NULL);
+    g_object_unref (task);
+}
+
+static void
+init_apply_radio_policy (MMBaseModem *self, GTask *task, gboolean restore)
+{
+    if (restore || !sim_radio_enabled (0) || !sim_radio_enabled (1)) {
+        /* The sequence retains pointers until its callback. Keep commands
+         * owned by this task, separately from the parent's port context. */
+        CardsOnContext *policy = g_slice_new0 (CardsOnContext);
+        guint n = 0;
+        guint card;
+        for (card = 0; card < 2; card++) {
+            if (sim_radio_enabled (card))
+                continue;
+            policy->cmds[n].command = g_strdup_printf ("+SPACTCARD=%u;+SFUN=5", card);
+            policy->cmds[n++].timeout = 30;
+        }
+        policy->cmds[n].command = g_strdup_printf ("+SPACTCARD=%u;+CFUN?", port_card ());
+        policy->cmds[n++].timeout = 5;
+        for (card = 0; card < n; card++)
+            policy->cmds[card].response_processor = mm_base_modem_response_processor_no_result_continue;
+        g_object_set_data_full (G_OBJECT (task), "sim-radio-policy", policy,
+                                (GDestroyNotify) cards_on_context_free);
+        mm_base_modem_at_sequence (self, (const MMBaseModemAtCommand *) policy->cmds, NULL, NULL,
+                                  (GAsyncReadyCallback) init_radio_policy_ready, task);
+        return;
+    }
+    g_task_return_pointer (task, g_task_get_task_data (task), NULL);
+    g_object_unref (task);
+}
+
+/* SFUN=5 may report CFUN=0 with a powered SIM. If the other stack is
+ * already on, do not mistake a deliberately disabled card for a cold CP. */
+static void
+init_peer_cfun_ready (MMBaseModem *self, GAsyncResult *res, GTask *task)
+{
+    GError *error = NULL;
+    guint power;
+    const gchar *response = mm_base_modem_at_command_finish (self, res, &error);
+
+    if (!error && (!power_parse_cfun (response, &power) ||
+                   (power != 0 && power != 1 && power != 2 && power != 4)))
+        error = g_error_new (MM_CORE_ERROR, MM_CORE_ERROR_FAILED, "Invalid peer +CFUN readback during initialization");
+    if (error) {
+        init_power_failed (self, task, error);
+        return;
+    }
+    if (power == 1)
+        init_apply_radio_policy (self, task, TRUE);
+    else
+        cards_on (self, (GAsyncReadyCallback) init_sim_on_ready, task);
+}
+
