+/* After SFUN=5, CFUN=0 does not imply that the SIM lost power. */
+static void
+power_up_cpin_ready (MMBaseModem *self, GAsyncResult *res, GTask *task)
+{
+    GError *error = NULL;
+    const gchar *response = mm_base_modem_at_command_finish (self, res, &error);
+
+    /* RF permission may have changed while the SIM query was in flight. */
+    if (!sim_radio_enabled (port_card ())) {
+        g_clear_error (&error);
+        if (sim_radio_enabled (1 - port_card ()))
+            g_task_return_boolean (task, TRUE);
+        else
+            g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_WRONG_STATE,
+                                     "This SIM radio is disabled by the user");
+        g_object_unref (task);
+        return;
+    }
+    if (error && g_error_matches (error, MM_MOBILE_EQUIPMENT_ERROR,
+                                 MM_MOBILE_EQUIPMENT_ERROR_SIM_NOT_INSERTED)) {
+        g_clear_error (&error);
+        cards_on (self, (GAsyncReadyCallback) power_sequence_ready, task);
+        return;
+    }
+    if (!error && (!response || !strstr (response, "+CPIN:")))
+        error = g_error_new (MM_CORE_ERROR, MM_CORE_ERROR_FAILED, "Invalid SIM power readback during power-up");
+    if (error) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+    mm_base_modem_at_command (self, "+SFUN=4", 30, FALSE,
+                              (GAsyncReadyCallback) power_command_ready, task);
 }

